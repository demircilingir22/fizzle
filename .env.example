GROQ_API_KEY=PASTE_KEY_HERE
AI_BASE_URL=https://api.groq.com/openai/v1
AI_REFEREE_MODEL=openai/gpt-oss-120b
AI_TOPIC_MODEL=openai/gpt-oss-120b

# Optional (production): Upstash Redis for online rooms, so every serverless instance
# shares them. Leave unset for local dev to keep rooms in memory. Vercel's Upstash
# integration may provide KV_REST_API_URL / KV_REST_API_TOKEN instead; both work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: how often online clients poll during a match, in ms (100-2000).
# Defaults to 250 in memory and 500 with Redis; lobby/results screens poll at
# least every 1000. Higher = fewer Vercel invocations and Redis commands, but
# answers and turn changes show up later on other screens (clocks stay fair:
# a handed-over turn starts one interval late).
ROOM_POLL_MS=
